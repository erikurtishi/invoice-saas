# apps/api — copy to .env and fill in. Never commit .env (see root .gitignore).

# development | test | production
NODE_ENV=development
PORT=4000

# Origin allowed by CORS — the web app's URL.
WEB_ORIGIN=http://localhost:5173

# Postgres connection string (decision D2). REQUIRED — the API will not boot without it.
DATABASE_URL=postgresql://user:password@localhost:5432/invoice_saas

# --- Auth (backlog Epic 1.1) ---
# Secret for signing access JWTs. REQUIRED, min 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-insecure-change-me-0000000000000000
# Access-token lifetime (seconds) and refresh-token lifetime (days). Defaults shown.
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Base URL for links in verification / reset emails. Defaults to WEB_ORIGIN.
# APP_URL=http://localhost:5173

# --- Uploads (backlog 1.2.3) ---
# Directory the local-disk file store writes to, relative to apps/api. Served at
# /uploads. Swapped for a cloud object store later (see lib/storage/index.ts).
UPLOAD_DIR=var/uploads

# --- Stripe billing (backlog Epic 6.2) ---
# All optional. With STRIPE_SECRET_KEY unset the app boots with a NullBilling
# adapter and /billing/checkout + /billing/portal return 503.
# Prefer a RESTRICTED key (rk_...) with least privilege over a secret key (sk_...).
# Never commit a live key. Get sandbox keys with: stripe sandbox create
STRIPE_SECRET_KEY=
# Local: run `stripe listen --forward-to localhost:4000/billing/webhook` and copy
# the whsec_... it prints. Production: the signing secret of the Dashboard endpoint.
STRIPE_WEBHOOK_SECRET=
# Optional: pin exact Price IDs. Blank -> resolved by lookup_key at runtime.
# Create the products/prices with: npm run stripe:setup -w @invoice-saas/api
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
# Optional: Customer Portal configuration id (bpc_...), printed by stripe:setup.
STRIPE_PORTAL_CONFIG_ID=
