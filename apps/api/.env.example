# apps/api — copy to .env and fill in. Never commit .env (see root .gitignore).

# development | test | production
NODE_ENV=development
PORT=4000

# Origin allowed by CORS — the web app's URL.
WEB_ORIGIN=http://localhost:5173

# Postgres connection string (decision D2). REQUIRED — the API will not boot without it.
DATABASE_URL=postgresql://user:password@localhost:5432/invoice_saas
