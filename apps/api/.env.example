# apps/api — copy to .env and fill in. Never commit .env (see root .gitignore).

# development | test | production
NODE_ENV=development
PORT=4000

# Origin allowed by CORS — the web app's URL.
WEB_ORIGIN=http://localhost:5173

# Postgres connection string (decision D2). REQUIRED — the API will not boot without it.
DATABASE_URL=postgresql://user:password@localhost:5432/invoice_saas

# --- Auth (backlog Epic 1.1) ---
# Secret for signing access JWTs. REQUIRED, min 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-insecure-change-me-0000000000000000
# Access-token lifetime (seconds) and refresh-token lifetime (days). Defaults shown.
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Base URL for links in verification / reset emails. Defaults to WEB_ORIGIN.
# APP_URL=http://localhost:5173

# --- Uploads (backlog 1.2.3) ---
# Directory the local-disk file store writes to, relative to apps/api. Served at
# /uploads. Swapped for a cloud object store later (see lib/storage/index.ts).
UPLOAD_DIR=var/uploads

# --- Stripe billing (backlog Epic 6.2) ---
# All optional. With STRIPE_SECRET_KEY unset the app boots with a NullBilling
# adapter and /billing/checkout + /billing/portal return 503.
# Prefer a RESTRICTED key (rk_...) with least privilege over a secret key (sk_...).
# Never commit a live key. Get sandbox keys with: stripe sandbox create
STRIPE_SECRET_KEY=
# Local: run `stripe listen --forward-to localhost:4000/billing/webhook` and copy
# the whsec_... it prints. Production: the signing secret of the Dashboard endpoint.
STRIPE_WEBHOOK_SECRET=
# Optional: pin exact Price IDs. Blank -> resolved by lookup_key at runtime.
# Create the products/prices with: npm run stripe:setup -w @invoice-saas/api
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
# Optional: Customer Portal configuration id (bpc_...), printed by stripe:setup.
STRIPE_PORTAL_CONFIG_ID=

# --- Error monitoring (backlog X.5.5) ---
# Optional. With no DSN the Sentry SDK is never initialised (no-op). Set it in
# staging + production to a project DSN from a free Sentry account.
SENTRY_DSN=
# Performance trace sampling, 0-1. Errors are always sent regardless. Default 0.
SENTRY_TRACES_SAMPLE_RATE=0

# --- Transactional email (backlog 4.3.4 / L1.1, Decision A: Resend) ---
# Optional. With RESEND_API_KEY unset the app uses the ConsoleMailer, which prints
# the verification / reset link to the server log (fine for `npm run dev` + CI).
# In NODE_ENV=production the app refuses to boot without it. Sign up at resend.com
# (permanent free tier) and use the onboarding sandbox domain from localhost.
RESEND_API_KEY=
# Required whenever RESEND_API_KEY is set: the verified "from" address.
# Sandbox: onboarding@resend.dev  ·  Prod: e.g. billing@yourdomain (domain authed at V1.5.3)
MAIL_FROM=

# --- AI drafting (backlog Epic 7.1 / L1.2) ---
# Off by default: with AI_PROVIDER unset the app runs a NullDrafter,
# /ai/draft-invoice returns 503 and the web hides the panel. No model is
# contacted until you name a provider here. Two options:
#
#   1) An existing hosted model (e.g. Claude Haiku):
#        AI_PROVIDER=anthropic
#        ANTHROPIC_API_KEY=sk-ant-...
#        AI_MODEL=claude-haiku-4-5
#
#   2) Your own OpenAI-compatible endpoint (vLLM / llama.cpp / Ollama /v1 / bespoke):
#        AI_PROVIDER=custom
#        AI_BASE_URL=http://localhost:11434/v1
#        AI_MODEL=my-model
#        AI_API_KEY=            # optional — omit for an unauthenticated local server
#
AI_PROVIDER=
AI_MODEL=
ANTHROPIC_API_KEY=
AI_BASE_URL=
AI_API_KEY=
