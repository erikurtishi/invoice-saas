{
  "name": "@invoice-saas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "pdf:smoke": "node scripts/pdf-smoke.mjs",
    "render:check": "node scripts/render-check.mjs",
    "numbering:check": "tsx scripts/numbering-check.ts",
    "invoice:check": "tsx scripts/invoice-check.ts",
    "pdf:check": "tsx scripts/pdf-endpoint-check.ts",
    "history:check": "tsx scripts/history-check.ts",
    "entitlements:check": "tsx scripts/entitlements-check.ts",
    "ai:check": "tsx scripts/ai-draft-check.ts",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "stripe:check": "tsx scripts/stripe-check.ts",
    "grant": "tsx scripts/grant.ts",
    "grants:expire": "tsx scripts/expire-grants.ts",
    "grants:check": "tsx scripts/manual-grant-check.ts",
    "admin:check": "tsx scripts/admin-audit-check.ts",
    "overview:check": "tsx scripts/admin-overview-check.ts",
    "tenants:check": "tsx scripts/admin-tenant-check.ts",
    "usage:check": "tsx scripts/admin-usage-check.ts",
    "billing:check": "tsx scripts/admin-billing-check.ts",
    "support:check": "tsx scripts/admin-support-check.ts",
    "security:check": "tsx scripts/security-check.ts",
    "set-admin": "tsx scripts/set-admin.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "e2e:cleanup": "tsx scripts/e2e-cleanup.ts"
  },
  "dependencies": {
    "@invoice-saas/shared": "*",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.73.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "puppeteer": "^25.9.0",
    "sharp": "^0.35.4",
    "stripe": "^22.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "pdfjs-dist": "^6.3.289",
    "prisma": "^6.19.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  }
}
