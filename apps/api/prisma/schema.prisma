// Prisma schema — apps/api. See decision D11 (why Prisma over Knex) and D3 (why one
// `users` table instead of a Tenant/User split) in docs/decisions.md.
//
// Scope of this file grows with the backlog: 0.2.2 added `User`; Epic 1.1 adds the
// auth token tables (`RefreshToken`, `OneTimeToken`); Epic 1.2 adds the `tier` and
// `onboardingCompletedAt` columns on `User`. Client, Product, Template, Invoice,
// etc. arrive with their own phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
}

/// Billing tier (backlog 1.2.1). Set to FREE on signup. Phase 6's entitlement
/// service (`lib/entitlements.ts`, 6.1.2) is the source of truth for "what can this
/// account do": it resolves the `Subscription` rows below (Stripe + manual grants,
/// decision D5) to a highest active tier and writes the result back here as a
/// denormalised cache (decision D14 — kept, not dropped). `AuthUser.tier` reads this
/// cache. Nothing branches on it directly outside `entitlements.ts`.
enum UserTier {
  FREE
  BASIC
  PREMIUM
}

/// Lifecycle of a `Subscription` row (backlog 6.1.1). `ACTIVE` is the only state
/// that grants access; `PAST_DUE` is the Stripe grace period before downgrade
/// (6.2.5); `CANCELED` is an ended Stripe sub; `EXPIRED` is a manual grant whose
/// `endDate` has passed (flipped lazily by the entitlement lookup, 6.3.3).
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

/// Where a `Subscription` came from (backlog 6.1.1, spec §9). Both sources feed the
/// exact same entitlement logic — the app never cares which one granted access.
/// `STRIPE` rows are written by Epic 6.2's webhook handler; `MANUAL` rows by the
/// admin cash-grant flow in Epic 6.3.
enum SubscriptionSource {
  STRIPE
  MANUAL
}

enum PaperSize {
  A4
  LETTER
  LEGAL
  A5
}

/// One rendering engine, one type field that swaps a few labels/fields (spec §5,
/// backlog 4.1.4). Mirrors `DOCUMENT_TYPES` in `@invoice-saas/shared`
/// (`render/invoice-data.ts`) — keep the two in step.
enum DocumentType {
  INVOICE
  PROFORMA
  QUOTE
  CREDIT_NOTE
  RECEIPT
}

/// NOT payment status — paid/unpaid/overdue are explicitly out of scope (spec §6).
/// This is only draft-vs-saved: `DRAFT` is the compose-time autosave buffer
/// (4.2.6) and carries no `number`; `ISSUED` is set by the first explicit Save,
/// which allocates the gapless number (4.1.3).
enum InvoiceStatus {
  DRAFT
  ISSUED
}

/// Kinds of `InvoiceHistoryEvent` (backlog 5.1.2, spec §7). Mirrors
/// `INVOICE_EVENT_TYPES` in `@invoice-saas/shared` (`invoice-history.ts`) — keep
/// the two in step. No "issued" value: `CREATED` is emitted at finalize.
enum InvoiceEventType {
  CREATED
  EDITED
  DOWNLOADED
  SENT
  DUPLICATED_FROM
  DUPLICATED_INTO
}

/// How a `Client`'s address is held (backlog 2.1.3). `STRUCTURED` uses the
/// line1/line2/city/postalCode/country columns; `FREE_TEXT` uses `addressText`.
enum ClientAddressMode {
  STRUCTURED
  FREE_TEXT
}

enum Language {
  EN
  SQ
  MK
}

/// What a `OneTimeToken` row authorizes. One table, one `purpose` column, rather
/// than a near-identical table per flow (backlog 1.1.2 / 1.1.3).
enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// One row per signed-up business (decision D3): login credentials and business
/// profile live together, no separate `tenants` table. Every child table's owner
/// column is still named `tenant_id` and references this table's `id` — see D3 for
/// why, and 0.2.4 for the middleware/Prisma extension that enforces the scope.
model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  /// Null until the verification email is confirmed (1.1.2). Free-tier abuse
  /// prevention (the lifetime-invoice limit) keys off this, not just the row existing.
  emailVerifiedAt DateTime?

  /// 8.1.1 — admin routes double-check this; it is never the only gate.
  role UserRole @default(OWNER)

  /// Billing tier, assigned FREE at signup (1.2.1). See the `UserTier` note above:
  /// Phase 6's entitlement service supersedes this as the read path.
  tier UserTier @default(FREE)

  /// The tenant's Stripe Customer id (`cus_…`), created the first time they start
  /// checkout (Epic 6.2). One customer per tenant, reused for every subscription
  /// and for the Customer Portal. Null until they interact with billing. The
  /// Stripe customer's `metadata.userId` mirrors this row so a webhook can resolve
  /// the tenant even before this column is set.
  stripeCustomerId String? @unique

  /// Set when the user finishes or explicitly skips the post-signup onboarding
  /// wizard (1.2.4). Null → the web app routes them into the wizard on next load.
  onboardingCompletedAt DateTime?

  // --- Business profile (spec §3, backlog 1.2.2) ---
  businessName String
  logoUrl      String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  postalCode   String?
  country      String?
  /// VAT/tax registration number. Format varies by country (MK/AL/XK/US); validated
  /// as a plain string, not parsed.
  taxId        String?

  /// ISO 4217 code, e.g. "EUR", "USD", "MKD". Per-invoice currency (4.2.7) can override
  /// this default; it never changes a saved invoice's own currency.
  defaultCurrency String @default("EUR")

  /// Net payment terms in days (e.g. 14 = due 14 days after issue). Not free text, so
  /// due-date calculation (4.1.1) is a plain date add, not a parser.
  defaultPaymentTermsDays Int @default(14)

  defaultPaperSize  PaperSize @default(A4)
  preferredLanguage Language  @default(EN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  oneTimeTokens OneTimeToken[]
  clients       Client[]
  products      Product[]
  templates     Template[]
  invoices      Invoice[]

  invoiceNumberSequences   InvoiceNumberSequence[]
  invoiceNumberingSettings InvoiceNumberingSetting[]
  invoiceHistoryEvents     InvoiceHistoryEvent[]

  subscriptions Subscription[]
  usageCounter  UsageCounter?

  @@map("users")
}

/// A tenant's customer (spec §20, backlog Epic 2.1). Reusable across invoices.
///
/// Owner column is `tenantId` referencing `users.id` (decision D3); the tenant
/// scope is injected by the Prisma extension in `db/tenant-scope.ts` for every
/// query — `Client` is listed in that file's `TENANT_SCOPED_MODELS`.
///
/// Soft delete (decision D4): `deletedAt` is set instead of removing the row, so
/// invoices that already reference this client keep rendering. Every list / picker
/// query filters `deletedAt: null`; `X.7.22` covers the UI when a reference no
/// longer resolves at all.
model Client {
  id       String @id @default(cuid())
  tenantId String
  tenant   User   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name  String
  /// Optional — Send is disabled (not blocked) when a client has no email (spec §91).
  /// Stored lower-cased; not unique (two of a tenant's clients may share a billing inbox).
  email String?
  /// VAT / tax registration number. Plain string, format varies by country (MK/AL/XK/US).
  taxId String?

  addressMode  ClientAddressMode @default(STRUCTURED)
  addressLine1 String?
  addressLine2 String?
  city         String?
  postalCode   String?
  country      String?
  /// Whole address as one blob, used when `addressMode == FREE_TEXT`.
  addressText  String?

  /// ISO 4217 code overriding the tenant's `defaultCurrency` for this client's
  /// invoices. Null → inherit the tenant default. Curated list enforced at the API.
  currency String?

  notes String?

  /// Set by a soft delete (decision D4); null for a live client.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, name])
  @@map("clients")
}

/// A tenant's reusable line item (spec §21, backlog Epic 2.2): a saved
/// name/price/unit/tax-rate that pre-fills an invoice row.
///
/// Owner column `tenantId` → `users.id` (decision D3); scope injected by the
/// extension in `db/tenant-scope.ts` (`Product` is listed in
/// `TENANT_SCOPED_MODELS`). Soft delete (decision D4): `deletedAt` is set, the row
/// stays so invoices that reference it keep rendering.
///
/// Money/rate columns are integers (decision D17): `defaultPriceMinor` in minor
/// units of the tenant's `defaultCurrency` (no per-product currency, no FX),
/// `defaultTaxRateBp` in basis points. This keeps invoice arithmetic integer end
/// to end (backlog 4.1.2).
model Product {
  id       String @id @default(cuid())
  tenantId String
  tenant   User   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  /// Free-text unit label ("hour", "piece", "kg"). Not an enum.
  unit        String?

  /// Minor units, tenant default currency. Null → no standard price (set per invoice).
  defaultPriceMinor Int?
  /// Basis points (1800 = 18.00%). 0 = no tax.
  defaultTaxRateBp  Int  @default(0)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  invoiceLineItems InvoiceLineItem[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, name])
  @@map("products")
}

/// A saved invoice design (spec §2/§4, backlog Epic 3.3): a name plus the template
/// config JSON (block order, toggles, accent, font, paper, logo — 3.1.1).
///
/// Owner column `tenantId` → `users.id` (decision D3); scope injected by the
/// extension in `db/tenant-scope.ts` (`Template` is in `TENANT_SCOPED_MODELS`).
/// Soft-deleted (decision D4) so a historical invoice that references one keeps
/// rendering (3.3.5, X.7.22).
model Template {
  id       String @id @default(cuid())
  tenantId String
  tenant   User   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name   String
  /// Validated by `templateConfigSchema` (@invoice-saas/shared, 3.1.1) — schema-
  /// versioned, never read unparsed.
  config Json

  /// Exactly one live template per tenant is the default (3.3.4) — the picker's
  /// preselection and the free tier's only usable template (3.3.6). Enforced in a
  /// transaction, not a DB constraint.
  isDefault Boolean @default(false)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  invoices Invoice[]

  @@index([tenantId, deletedAt])
  @@map("templates")
}

/// A tenant's invoice / proforma / quote / credit note / receipt (spec §5–6,
/// backlog Epic 4.1). One model, one `documentType` that swaps a few
/// labels/fields — never a table per type.
///
/// Owner column `tenantId` → `users.id` (decision D3); scope injected by the
/// extension in `db/tenant-scope.ts` (`Invoice` is in `TENANT_SCOPED_MODELS`).
/// Soft-deleted (decision D4).
///
/// **Party & line snapshot (decision D20):** `clientId` / `templateId` /
/// `lineItems[].productId` are kept as live references (the rows are soft-deleted,
/// never removed, so they always resolve), but the printed name/address/tax-id of
/// both parties and every line's text are ALSO copied onto the row at Save time.
/// Editing a Client, Product or the business profile later never rewrites a
/// historical document.
///
/// **Money (decision D17):** every amount is integer minor units, every rate is
/// basis points. The `*Minor` totals are recomputed on every Save by the one
/// shared calculator (`computeInvoiceTotals`, `@invoice-saas/shared`) — the server
/// is the source of truth (4.2.3); the form's numbers are display-only.
model Invoice {
  id       String @id @default(cuid())
  tenantId String
  tenant   User   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Draft-vs-saved only — see the `InvoiceStatus` note. Not payment status.
  status       InvoiceStatus @default(DRAFT)
  documentType DocumentType  @default(INVOICE)

  /// Allocated from the per-`(tenantId, documentType, numberYear)` gapless
  /// sequence on the first explicit Save (4.1.3); null while `DRAFT`.
  /// `numberSeq` is the raw integer the counter handed out; `number` is that
  /// integer rendered through the tenant's format string (`InvoiceNumberingSetting`).
  number     String?
  numberSeq  Int?
  /// The calendar year the counter counted in, when the sequence resets yearly
  /// (4.1.3). Null for a continuous sequence or a still-draft invoice.
  numberYear Int?

  /// Printed-label language (spec §10), independent of the app UI language.
  language  Language  @default(EN)
  /// ISO 4217. May differ from the tenant/client default (4.2.7); frozen once the
  /// invoice is saved — changing the tenant default never rewrites it.
  currency  String    @default("EUR")
  paperSize PaperSize @default(A4)

  /// Live references — always resolve (soft delete, D4). Nullable so a `DRAFT`
  /// autosave (4.2.6) and the "start from scratch" flow (4.2.4, template created
  /// in the same Save) are representable. `Restrict` never fires because the rows
  /// are never hard-deleted.
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  // --- Snapshot of the issuing business at Save time (spec §3 party block) ---
  businessName    String?
  /// Newline-joined address block, printed verbatim.
  businessAddress String?
  businessEmail   String?
  businessPhone   String?
  businessTaxId   String?
  businessLogoUrl String?

  // --- Snapshot of the billed client at Save time ---
  clientName    String?
  clientAddress String?
  clientEmail   String?
  clientTaxId   String?

  issueDate     DateTime  @db.Date
  /// Invoice/Proforma → payment due; Quote → "valid until"; Credit note/Receipt → null.
  dueDate       DateTime? @db.Date
  /// Receipt only (spec §5).
  paidDate      DateTime? @db.Date
  paymentMethod String?

  /// Credit note only (4.1.5). `creditNoteRef` is the free-text original document
  /// number (always printed); `creditNoteOfId` additionally hard-links the
  /// original Invoice row when it is one of this tenant's.
  creditNoteRef  String?
  creditNoteOfId String?
  creditNoteOf   Invoice?  @relation("CreditNoteChain", fields: [creditNoteOfId], references: [id], onDelete: Restrict)
  creditNotes    Invoice[] @relation("CreditNoteChain")

  /// Buyer reference / PO number (render `reference`).
  reference      String?
  notes          String?
  footerText     String?
  signatureLabel String?

  // --- Computed totals, integer minor units (D17); recomputed every Save. ---
  subtotalMinor      Int @default(0)
  discountTotalMinor Int @default(0)
  taxTotalMinor      Int @default(0)
  grandTotalMinor    Int @default(0)
  /// What the document asks for now — equals `grandTotalMinor` for a plain
  /// invoice, `0` for a receipt.
  amountDueMinor     Int @default(0)

  lineItems     InvoiceLineItem[]
  historyEvents InvoiceHistoryEvent[]

  /// Set by the first explicit Save (alongside `number`). Distinct from
  /// `createdAt`, which is when the row was first autosaved as a draft.
  issuedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, documentType, numberYear, numberSeq])
  @@index([tenantId, deletedAt])
  @@index([tenantId, documentType, deletedAt])
  @@index([tenantId, clientId])
  @@index([tenantId, issueDate])
  @@map("invoices")
}

/// One row of an invoice (backlog 4.1.1). Reached only through its parent
/// `Invoice` relation, so it carries no `tenantId` and is NOT in
/// `TENANT_SCOPED_MODELS` — the tenant filter comes from the scoped `Invoice`
/// query that loads it. Cascade-deleted with the invoice (hard delete of the
/// child rows is fine; the invoice itself is soft-deleted).
///
/// `quantityMilli` is milli-units (1000 = "1", 2500 = "2.5") so a fractional
/// quantity stays exact without a float. All money/rate columns are integers (D17);
/// the `line*Minor` columns are recomputed on every Save by `computeLineItem`.
model InvoiceLineItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// 0-based render order; the form reorders rows (4.2.2).
  position Int

  /// Set when the row was prefilled from a Product (still resolves after a soft
  /// delete); null for a free-text row. The text below is the snapshot either way.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict)

  description    String
  quantityMilli  Int
  unit           String?
  unitPriceMinor Int
  /// Basis points (1800 = 18%).
  taxRateBp      Int     @default(0)
  /// Per-line discount, basis points of the line subtotal.
  discountBp     Int     @default(0)

  lineSubtotalMinor Int @default(0)
  lineDiscountMinor Int @default(0)
  lineTaxMinor      Int @default(0)
  lineTotalMinor    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId, position])
  @@map("invoice_line_items")
}

/// One entry in an invoice's history (spec §7, backlog Epic 5.1): what happened,
/// when, and who did it. Powers the per-invoice timeline (5.2.1) and the
/// dashboard-wide activity view (5.2.2).
///
/// **Append-only (5.1.3):** rows are only ever inserted. `invoice-history-service.ts`
/// is the single writer and exposes no update or delete; nothing branches on this
/// table for behaviour, so a missed event is a display gap, never a correctness
/// bug. There is no `deletedAt` — an entry outlives even a soft-deleted invoice
/// (it is removed only if the invoice row is ever hard-deleted, via cascade).
///
/// Owner column `tenantId` → `users.id` (decision D3); scope injected by the
/// extension in `db/tenant-scope.ts` (`InvoiceHistoryEvent` is in
/// `TENANT_SCOPED_MODELS`). `userId` is the acting user — the same value as
/// `tenantId` today, kept as its own column for when a tenant gains multiple
/// users. `metadata` is a small JSON bag whose keys depend on `eventType`,
/// validated by `invoiceHistoryMetadataSchema` (`@invoice-saas/shared`) before
/// every write — e.g. `{ recipient }` for `SENT`, `{ counterpartId }` linking the
/// other invoice for `DUPLICATED_*`.
model InvoiceHistoryEvent {
  id       String @id @default(cuid())
  tenantId String
  tenant   User   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  eventType InvoiceEventType
  /// Who performed the action (references `users.id`; not a Prisma relation — the
  /// write path stays a plain insert with no back-relation on `User`).
  userId    String

  /// Event-type-dependent JSON, `{}` when the event carries no extra detail.
  /// Validated by `invoiceHistoryMetadataSchema` (`@invoice-saas/shared`).
  metadata Json @default("{}")

  /// When it happened. Named `timestamp` per backlog 5.1.1 (not `createdAt`);
  /// there is no `updatedAt` — the row never changes.
  timestamp DateTime @default(now())

  @@index([invoiceId, timestamp])
  @@index([tenantId, timestamp])
  @@index([tenantId, eventType])
  @@map("invoice_history_events")
}

/// The gapless counter behind invoice numbering (backlog 4.1.3). One row per
/// `(tenantId, documentType, year)` — the five document types each have their own
/// sequence (decision D20), and when `InvoiceNumberingSetting.resetYearly` is on
/// there is one row per calendar year (`year` = 0 for a continuous sequence).
///
/// `nextValue` is the last number handed out. Allocation is a single atomic
/// `INSERT … ON CONFLICT DO UPDATE … RETURNING` in `services/invoice-numbering.ts`
/// — the one sanctioned raw-SQL path called out in `db/tenant-scope.ts`, and it
/// carries its own explicit `tenantId` predicate. `Invoice` is in
/// `TENANT_SCOPED_MODELS` too, so ordinary Prisma reads of this table are still
/// tenant-scoped.
model InvoiceNumberSequence {
  id       String @id @default(cuid())
  tenantId String
  tenant   User   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  documentType DocumentType
  /// Calendar year for a yearly-reset sequence; `0` for a continuous one.
  year         Int          @default(0)

  /// Last number allocated. Next document gets `nextValue + 1`.
  nextValue Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, documentType, year])
  @@map("invoice_number_sequences")
}

/// Per-tenant, per-document-type numbering configuration (backlog 4.1.3:
/// "configurable prefix/format"). Lazily seeded with a sensible default the first
/// time a tenant issues a document of that type (see `invoice-numbering.ts`).
///
/// `format` is a token string — `{prefix}`, `{YYYY}`, `{YY}`, `{seq}` — where
/// `{seq}` is left-padded to `seqPadding` digits. `resetYearly` is the tenant's
/// choice (4.1.3): when true the counter restarts at 1 each January and the year
/// tokens reflect the document's issue year; when false the counter is continuous.
model InvoiceNumberingSetting {
  id       String @id @default(cuid())
  tenantId String
  tenant   User   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  documentType DocumentType

  format      String
  seqPadding  Int     @default(4)
  resetYearly Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, documentType])
  @@map("invoice_numbering_settings")
}

/// A grant of a paid tier to a tenant (backlog 6.1.1, spec §9). One tenant can hold
/// several rows over time and more than one active at once (e.g. a manual grant that
/// overlaps a Stripe sub) — the entitlement service (`lib/entitlements.ts`, 6.1.2)
/// resolves all `ACTIVE` rows to a single highest tier (decision D5, "most access
/// wins"), so both records are preserved and neither has to be cleaned up first.
///
/// Fields 6.1.1 asks for, plus the Stripe linkage added in Epic 6.2. Epic 6.3
/// adds the manual-grant `note`.
///
/// Owner column `tenantId` → `users.id` (decision D3). `Subscription` is in
/// `TENANT_SCOPED_MODELS` so an accidental `req.db.subscription` read can't cross
/// tenants, but the sanctioned reader is the entitlement service, which uses the
/// unscoped client with an explicit `tenantId` (it also runs from auth/session
/// contexts that have no `req.db`).
///
/// One row per Stripe subscription (`stripeSubscriptionId` unique), upserted by
/// the webhook handler (6.2.3). Manual grants (6.3) leave the Stripe columns null.
model Subscription {
  id       String @id @default(cuid())
  tenantId String
  tenant   User   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tier   UserTier
  status SubscriptionStatus @default(ACTIVE)
  source SubscriptionSource

  /// When access begins. A future `startDate` means the row is not active yet.
  startDate DateTime  @default(now())
  /// When access ends. Null = open-ended (a live Stripe recurring sub that keeps
  /// renewing); set to a concrete date for manual grants (spec §9), for a Stripe
  /// sub scheduled to cancel at period end, and for a cancelled one.
  endDate   DateTime?

  // --- Stripe linkage (Epic 6.2); null for manual grants ---
  /// The `sub_…` id. Unique — the webhook upserts on it.
  stripeSubscriptionId String? @unique
  /// The `price_…` currently on the subscription (its tier is derived from this).
  stripePriceId        String?
  /// `current_period_end` from Stripe — the next renewal instant, shown as
  /// "renews on …" while active and not cancelling.
  currentPeriodEnd     DateTime?
  /// Stripe's `cancel_at_period_end`: access continues until `endDate`, then stops.
  cancelAtPeriodEnd    Boolean   @default(false)

  // --- Manual grant (Epic 6.3); null for Stripe rows ---
  /// Free-text context an admin records with a cash grant, e.g. "€20 cash, 2
  /// months" (backlog 6.3.1).
  note             String?
  /// The admin `users.id` that issued this manual grant — a lightweight audit
  /// trail (backlog 8.1.2 builds the full `AdminAuditLog`). Not a Prisma relation,
  /// so the write path stays a plain insert. Null for Stripe rows and for grants
  /// issued by the CLI.
  grantedByUserId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@map("subscriptions")
}

/// Webhook idempotency (backlog 6.2.3 — "idempotent"). The handler inserts the
/// Stripe event id before doing any work; a duplicate delivery hits the unique
/// PK and is skipped. Not tenant-scoped — Stripe events are global.
model ProcessedStripeEvent {
  /// The Stripe `evt_…` id.
  id        String   @id
  type      String
  createdAt DateTime @default(now())

  @@map("processed_stripe_events")
}

/// Per-tenant usage meters enforced server-side (backlog 6.1.3, spec §9 — "not just
/// in the UI"). One row per tenant, created lazily on the first metered action.
///
/// `lifetimeInvoicesGenerated` only ever increments — it is bumped inside the
/// finalize transaction (`invoice-service.finalizeInvoice`), so soft-deleting an
/// issued invoice never hands a Free account its one lifetime invoice back (6.1.5).
/// `aiGenerationsInPeriod` is a calendar-month counter (decision D6, 50/mo on
/// Premium): when `aiPeriodKey` ("YYYY-MM", UTC) no longer matches the current
/// month the entitlement service treats the count as 0 and the next increment
/// rewrites the key. Empty `aiPeriodKey` = never used.
///
/// Scoping: same arrangement as `Subscription` — in `TENANT_SCOPED_MODELS` as a
/// guard, but written/read through `lib/entitlements.ts` on the unscoped client
/// with an explicit `tenantId`.
model UsageCounter {
  tenantId String @id
  tenant   User   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  lifetimeInvoicesGenerated Int @default(0)

  aiGenerationsInPeriod Int    @default(0)
  aiPeriodKey           String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("usage_counters")
}

/// One row per issued refresh token (backlog 1.1.1). The raw token is a random
/// opaque string held only in the client's httpOnly cookie; we store its SHA-256
/// hash so a database leak can't be replayed as a live session.
///
/// Rotation: `/auth/refresh` consumes the presented row (sets `revokedAt` +
/// `replacedById`) and issues a fresh one. A token that is presented after it was
/// already rotated is treated as theft — the whole chain for that user is revoked.
model RefreshToken {
  id        String @id @default(cuid())
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt    DateTime
  /// Set when the token is rotated (normal use) or force-revoked (logout, password
  /// reset, detected reuse). A row with `revokedAt == null && expiresAt > now` is
  /// the only kind that authenticates a refresh.
  revokedAt    DateTime?
  /// The token this one was rotated into, for reuse detection.
  replacedById String?   @unique

  /// Coarse client fingerprint, for the "active sessions" view a later phase may add.
  userAgent String?
  ip        String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// Single-use, time-limited tokens for the email-verification (1.1.2) and
/// password-reset (1.1.3) flows. Same storage rule as `RefreshToken`: only the
/// SHA-256 hash is persisted. `consumedAt` makes a token single-use; issuing a new
/// token of the same purpose for a user invalidates that user's older unconsumed
/// ones so only the most recent link works.
model OneTimeToken {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  purpose   TokenPurpose

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, purpose])
  @@map("one_time_tokens")
}
