# apps/web — copy to .env and fill in. Never commit .env (see root .gitignore).
#
# Only VITE_-prefixed variables are exposed to the browser bundle.
# Everything here ships to the client: never put a secret in this file.

VITE_API_URL=http://localhost:4000

# Error monitoring (backlog X.5.5). Optional — no value means the Sentry SDK is
# never loaded. A browser DSN is public, not a secret.
VITE_SENTRY_DSN=
