# Dependencies
node_modules

# Build output
dist
dist-ssr
build
*.tsbuildinfo

# Environment — never commit real secrets (see .env.example files)
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.swp

# Test / coverage output
coverage
playwright-report
test-results

# Runtime artefacts (generated PDFs, uploaded logos) — never in the repo.
# Anchored to the API's runtime dir so it can't shadow source folders
# (e.g. apps/api/src/lib/storage/, which is the Storage port — decision D15).
apps/api/var/
