{
  "name": "invoice-saas",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "npm run build -w @invoice-saas/shared && npm run dev -w @invoice-saas/web",
    "dev:api": "npm run build -w @invoice-saas/shared && npm run dev -w @invoice-saas/api",
    "dev:shared": "npm run dev -w @invoice-saas/shared",
    "build": "npm run build -w @invoice-saas/shared && npm run build -w @invoice-saas/api && npm run build -w @invoice-saas/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "clean": "npm run clean --workspaces --if-present",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "pdf:smoke": "npm run pdf:smoke -w @invoice-saas/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
